# Connect Booked Out (one Google Allow per client) - proxied to the Cloudflare worker, URL stays on our domain
/connect            https://bookedout-connect.rickey-38a.workers.dev/connect            200!
/connect/*          https://bookedout-connect.rickey-38a.workers.dev/connect/:splat     200!

# Client one-tap pages (Nov 15) - served and saved by the bookedout-answers worker, URL stays on our domain
/c/*                    https://bookedout-answers.rickey-38a.workers.dev/c/:splat                    200!
/api/client-answer      https://bookedout-answers.rickey-38a.workers.dev/api/client-answer           200!
/api/client-answer/*    https://bookedout-answers.rickey-38a.workers.dev/api/client-answer/:splat    200!

# Free report (Nov 16) - saved and built by the bookedout-freereport worker, URL stays on our domain
/api/free-report        https://bookedout-freereport.rickey-38a.workers.dev/api/free-report          200!
/api/free-report/*      https://bookedout-freereport.rickey-38a.workers.dev/api/free-report/:splat   200!
/r/*                    https://bookedout-freereport.rickey-38a.workers.dev/r/:splat                 200!
